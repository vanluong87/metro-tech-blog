---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'vi' && !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.split('/').pop() },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const slug = post.id.split('/').pop();

const enTwin = await getEntry('blog', `en/${slug}`);

const formattedDate = post.data.date.toLocaleDateString('vi-VN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  lang="vi"
  title={post.data.title}
  description={post.data.description}
  path={`/vi/blog/${slug}/`}
  altPaths={enTwin ? { en: `/en/blog/${slug}/` } : {}}
  type="article"
>
  <a class="back-link" href="/vi/blog/">← Quay lại danh sách bài viết</a>
  <article class="post">
    <h1>{post.data.title}</h1>
    <div class="meta">
      {post.data.country} · {formattedDate}
      {post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
    </div>
    <Content />
  </article>
</BaseLayout>
