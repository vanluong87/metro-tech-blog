---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n/ui';

const t = ui.en;
---

<BaseLayout
  lang="en"
  title={t.about_title}
  description={t.home_intro}
  path="/en/about/"
  altPaths={{ vi: '/vi/about/' }}
>
  <section class="hero">
    <h1>{t.about_title}</h1>
    <p>
      This site collects and shares real-world experience on metro (subway) construction
      technology from countries around the world — including methods such as TBM shield
      tunneling, NATM, Cut &amp; Cover, underground station construction, urban geotechnical
      risk management, and practical lessons from the field.
    </p>
    <p>
      The goal is to build an accessible, useful reference for engineers, students, and
      anyone interested in urban transit infrastructure in Vietnam and the wider region.
    </p>
  </section>
</BaseLayout>
