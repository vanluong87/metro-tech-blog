---
import type { CollectionEntry } from 'astro:content';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = ui[lang];
const slug = post.id.split('/').pop();
const formattedDate = post.data.date.toLocaleDateString(lang === 'vi' ? 'vi-VN' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<li class="post-card">
  <h2><a href={`/${lang}/blog/${slug}/`}>{post.data.title}</a></h2>
  <div class="meta">{post.data.country} · {formattedDate}</div>
  <p class="desc">{post.data.description}</p>
  <div style="margin-top: 12px;">
    {post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
  </div>
  <p style="margin-top: 12px; margin-bottom: 0;">
    <a href={`/${lang}/blog/${slug}/`}>{t.read_more} →</a>
  </p>
</li>
